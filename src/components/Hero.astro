---
import {cloudinarySrcset, cloudinaryUrl} from '../lib/cloudinary'
import type {content} from '../lib/content'
import {type Locale, localize} from '../lib/i18n'
import {ui} from '../lib/ui'
import Button from './Button.astro'
import Logo from './Logo.astro'

type Props = {profile: typeof content.profile; cvUrl: string | null | undefined; locale: Locale}

const {profile, cvUrl, locale} = Astro.props
const t = ui[locale]
const bio = localize(profile.bio, locale)
const cutoutUrl = profile.cutout?.url
const cutout = cutoutUrl && {
  ...profile.cutout,
  src: cloudinaryUrl(cutoutUrl, 1200),
  srcset: cloudinarySrcset(cutoutUrl),
}
---

<section
  id="inicio"
  class="hero"
  aria-labelledby="inicio-title"
  style={cutout && `--ratio: ${cutout.width} / ${cutout.height}`}
>
  <div class="intro">
    <Logo size={96} />
    <h1 id="inicio-title">
      <span class="alias">{profile.alias}</span>{' '}
      <span class="name">{profile.displayName}</span>
    </h1>
    {bio && <p class="bio">{bio}</p>}
    <div class="actions">
      {
        cvUrl && (
          <Button variant="primary" href={cvUrl}>
            {t.viewCv}
          </Button>
        )
      }
      <Button variant="tertiary" href="#contacto" icon="ph:arrow-right-light">
        {t.contactMe}
      </Button>
    </div>
  </div>
  {
    cutout && (
      <img
        class="cutout"
        src={cutout.src}
        srcset={cutout.srcset}
        sizes="(width < 768px) 100vw, 55vw"
        width={cutout.width}
        height={cutout.height}
        alt={localize(cutout.alt, locale)}
        fetchpriority="high"
      />
    )
  }
</section>

<style>
  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    max-height: 62.5svh;
    padding: 0 var(--gutter);
    container-type: inline-size;
    overflow: hidden;
  }

  .intro,
  .cutout {
    --space: calc(var(--rail) * 2 / 3);
    --cutout-width: min((62.5svh - var(--header) - 2 * var(--space)) * var(--ratio, 0), 55cqw);
  }

  .intro {
    --u: min(
      (62.5svh - var(--header) - 2 * var(--space) - var(--s12)) / 249,
      (100cqw - var(--cutout-width)) / 340
    );
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: calc(var(--header) + var(--space)) 0 var(--space);
  }

  .intro > * + * {
    margin-top: calc(16 * var(--u));
  }

  .intro > :global(svg) {
    width: calc(96 * var(--u));
    height: auto;
    color: var(--accent-text);
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .alias {
    font-size: calc(76 * var(--u));
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .name {
    margin-top: calc(16 * var(--u));
    font-size: max(var(--text-xs), calc(14 * var(--u)));
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bio,
  .actions {
    align-self: stretch;
    contain: inline-size;
  }

  .bio {
    margin-top: calc(24 * var(--u));
    font-size: var(--text-base);
    font-weight: 350;
    color: var(--ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s6);
    margin-top: calc(32 * var(--u));
  }

  .cutout {
    flex-shrink: 0;
    width: var(--cutout-width);
    height: auto;
    margin: calc(var(--header) + var(--space)) calc(-1 * var(--gutter)) var(--space) 0;
    mask-image: linear-gradient(black 75%, transparent);
  }

  @media (width < 768px) {
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(5, auto) 1fr;
      height: 62.5svh;
      padding-top: calc(var(--header) + var(--s4));
      container-type: size;
    }

    .intro {
      --u: min(100cqh / 640, 100cqw / 340);
      display: contents;
    }

    .intro > * {
      grid-column: 1 / -1;
    }

    .intro > :global(svg) {
      width: calc(64 * var(--u));
    }

    .bio,
    .actions {
      grid-column: 1;
      z-index: 1;
    }

    .bio {
      grid-row: 4;
    }

    .actions {
      grid-row: 5;
    }

    .cutout {
      margin: 0;
      grid-row: 4 / -1;
      grid-column: 1 / -1;
      width: calc(100% + var(--gutter));
      height: 100%;
      contain: size;
      object-fit: contain;
      object-position: right bottom;
    }
  }
</style>
