---
import type {HTMLAttributes} from 'astro/types'

type Props = Omit<HTMLAttributes<'a'>, 'type'> & {
  variant: 'primary' | 'secondary' | 'tertiary' | 'icon'
  size?: 'large'
}

const {variant, size, href, ...rest} = Astro.props
const Element = href ? 'a' : 'button'
---

<Element class:list={['button', variant, size]} href={href} {...rest}>
  <slot />
</Element>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    min-height: var(--s12);
    padding: 0 var(--s6);
    font-size: 14px;
    font-weight: 500;
    border: var(--stroke) solid transparent;
    text-shadow: none;
    transition: transform var(--fast) ease-out;
  }

  .button:hover {
    transform: scale(1.04);
  }

  .button:active {
    transform: translateY(2px);
  }

  .primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .secondary {
    border-color: var(--ink);
  }

  .tertiary {
    min-height: 0;
    padding: 0 0 var(--s1);
    border-width: 0 0 var(--stroke);
    border-bottom-color: var(--ink);
  }

  .icon {
    width: var(--s8);
    min-height: var(--s8);
    padding: 0;
    border-color: var(--line);
  }

  .large {
    min-height: var(--s16);
    padding: 0 var(--s8);
    font-size: 18px;
  }
</style>
