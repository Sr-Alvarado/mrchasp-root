---
import type {HTMLAttributes} from 'astro/types'
import {Icon} from 'astro-icon/components'

type Props = Omit<HTMLAttributes<'a'>, 'type'> & {
  variant: 'primary' | 'secondary' | 'tertiary'
  icon?: string
  iconPosition?: 'start' | 'end'
}

const {variant, icon, iconPosition = 'end', href, ...rest} = Astro.props
const Element = href ? 'a' : 'button'
const url = href ? new URL(href, Astro.site) : undefined
const external = url?.protocol.startsWith('http') && url.origin !== Astro.site?.origin
---

<Element
  class:list={['button', variant, iconPosition, {square: !Astro.slots.has('default')}]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <slot />
  {icon && <Icon name={icon} />}
</Element>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    min-height: var(--s12);
    padding: 0 var(--s6);
    font-size: var(--text-base);
    font-weight: 500;
    border: var(--stroke) solid transparent;
    text-shadow: none;
    transition: transform var(--fast) ease-out;
  }

  .button:hover {
    transform: scale(1.04);
  }

  .button:active {
    transform: translateY(2px);
  }

  .start {
    flex-direction: row-reverse;
  }

  .square {
    width: var(--s12);
    padding: 0;
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }

  .secondary {
    border-color: var(--ink);
  }

  .tertiary {
    padding: 0;
    text-decoration: underline var(--stroke);
    text-underline-offset: var(--s1);
  }
</style>
