---
import type {FeedEntry} from '../lib/content'
import type {Locale} from '../lib/i18n'
import Card from './Card.astro'
import Tag from './Tag.astro'

type Props = {item: FeedEntry; color: string | undefined; locale: Locale}

const {item, color, locale} = Astro.props
const date = new Intl.DateTimeFormat(locale, {dateStyle: 'medium'}).format(new Date(item.publishedAt))
---

<Card href={item.url} image={item.image} data-day={item.publishedAt}>
  <Tag slot="head" color={color}>{item.source} · {date}</Tag>
  {item.title && <h3 slot="head">{item.title}</h3>}
  {item.text && <p>{item.text}</p>}
</Card>
