---
import type {NavItem} from '../lib/navigation'
import NavMarker from './NavMarker.astro'

type Props = {items: NavItem[]; label: string}

const {items, label} = Astro.props
---

<nav class="bar" aria-label={label}>
  <ul>
    {
      items.map((item) => (
        <li style={`--chars: ${item.label.length}`}>
          <a href={item.href} data-nav={item.id}>
            <NavMarker item={item} />
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '../scripts/activeSection'
</script>

<style>
  .bar {
    display: none;
  }

  ul {
    display: flex;
    height: 100%;
  }

  li {
    flex: 0 0 var(--s8);
    min-width: var(--s8);
    container-type: size;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    height: 100%;
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
    transition: font-size var(--fast) ease-out;
  }

  .label {
    max-width: 0;
    overflow: hidden;
  }

  @container (width > 120px) {
    a {
      justify-content: flex-start;
      gap: var(--s3);
      padding-left: var(--s4);
      font-size: clamp(
        var(--text-xs),
        (100cqw - 2 * var(--s4) - var(--s3)) / (var(--chars) * 0.62 + 1),
        var(--text-xl)
      );
      font-weight: 700;
    }

    .label {
      max-width: 100%;
    }

    a > :global(*:first-child) {
      width: 1em;
      height: 1em;
    }
  }

  @media (width < 768px) {
    .bar {
      display: block;
      position: fixed;
      inset: auto 0 0;
      z-index: 2;
      height: var(--bar);
      background: var(--ink);
      color: var(--bg);
    }
  }
</style>
