---
import type {NavItem} from '../lib/navigation'
import NavMarker from './NavMarker.astro'

type Props = {items: NavItem[]; label: string}

const {items, label} = Astro.props
---

<nav class="bar" aria-label={label}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} data-nav={item.id}>
            <NavMarker item={item} />
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '../scripts/activeSection'
</script>

<style>
  .bar {
    display: none;
  }

  ul {
    display: flex;
    height: 100%;
  }

  li {
    flex: 0 0 var(--s8);
    min-width: 0;
    transition: flex-grow var(--slow) ease-out;
  }

  li:has([aria-current]) {
    flex-grow: 1;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    height: 100%;
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
  }

  .label {
    max-width: 0;
    overflow: hidden;
  }

  [aria-current] .label {
    max-width: 100%;
  }

  @media (width < 768px) {
    .bar {
      display: block;
      position: fixed;
      inset: auto 0 0;
      z-index: 2;
      height: var(--bar);
      background: var(--ink);
      color: var(--bg);
    }
  }
</style>
