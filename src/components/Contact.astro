---
import {channelIcon} from '../lib/channelIcon'
import type {ChannelEntry} from '../lib/content'
import {type Locale} from '../lib/i18n'
import {ui} from '../lib/ui'
import Button from './Button.astro'

type Props = {channels: ChannelEntry[]; cvUrl: string | null | undefined; locale: Locale}

const {channels, cvUrl, locale} = Astro.props
const email = channels.find((channel) => channel.url?.startsWith('mailto:'))
---

<div class="contact">
  {email && <a class="email" href={email.url}>{email.handle}</a>}
  <ul class="channels">
    {
      channels.map((channel) => (
        <li>
          <Button
            variant="secondary"
            href={channel.url}
            icon={channelIcon(channel.platform)}
            iconPosition="start"
          >
            {channel.platform}
          </Button>
        </li>
      ))
    }
  </ul>
  {
    cvUrl && (
      <Button variant="primary" href={cvUrl}>
        {ui[locale].viewCv}
      </Button>
    )
  }
</div>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s8);
  }

  .email {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-5xl));
    font-weight: 700;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--accent-text);
  }

  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
</style>
