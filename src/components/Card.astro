---
import type {HTMLAttributes} from 'astro/types'
import {cloudinarySrcset, cloudinaryUrl} from '../lib/cloudinary'

type Props = HTMLAttributes<'a'> & {image?: string | null | undefined}

const {href, image, ...rest} = Astro.props
const Element = href ? 'a' : 'article'
---

<Element
  class="card"
  href={href}
  target={href && '_blank'}
  rel={href && 'noopener noreferrer'}
  {...rest}
>
  <div class="body">
    <slot name="head" />
    {
      image && (
        <img
          src={cloudinaryUrl(image, 800)}
          srcset={cloudinarySrcset(image)}
          sizes="(width < 768px) 90vw, (width < 1024px) 45vw, 30vw"
          alt=""
          loading="lazy"
        />
      )
    }
    <slot />
  </div>
</Element>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    backdrop-filter: var(--card-blur);
    border: var(--stroke) solid var(--line);
    text-shadow: none;
    transition: border-color var(--fast) ease-out;
  }

  a.card:hover {
    border-color: var(--accent);
  }

  img {
    width: calc(100% + 2 * var(--s4));
    margin: var(--s2) calc(-1 * var(--s4));
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s2);
    padding: var(--s4);
  }

  .body > :global(:is(.tag, .status, h3, img, p) + :not(.tag, .status, h3, img, p)) {
    margin-top: auto;
  }

  .body :global(h3) {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.3;
  }

  .body :global(p) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: var(--text-base);
    color: var(--ink-muted);
  }
</style>
