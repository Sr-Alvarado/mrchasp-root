---
import type {NavItem} from '../lib/navigation'
import NavMarker from './NavMarker.astro'

type Props = {items: NavItem[]; label: string}

const {items, label} = Astro.props
---

<nav class="rail" aria-label={label}>
  <ul>
    {
      items.map((item) => (
        <li class={item.variant}>
          <a href={item.href} data-nav={item.id}>
            <NavMarker item={item} />
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '../scripts/activeSection'
</script>

<style>
  .rail {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 2;
    width: var(--rail);
    background: var(--ink);
    color: var(--bg);
  }

  ul {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  li {
    flex: 0 0 var(--s6);
    overflow: hidden;
    border-bottom: var(--stroke) solid color-mix(in srgb, currentColor 15%, transparent);
    transition: flex-grow var(--slow) ease-out;
  }

  li:has([aria-current]) {
    flex-grow: 1;
  }

  .home,
  .now {
    flex-basis: 56px;
  }

  a {
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    height: 100%;
    padding: var(--s2) 0 0 var(--s2);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: var(--s2);
  }

  a:hover {
    text-decoration: underline;
  }

  .home a,
  .now a {
    flex-direction: column;
    align-items: center;
    gap: var(--s3);
    padding: var(--s4) 0;
  }

  .home .label,
  .now .label {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .now :global(.marker),
  .home a:not([aria-current]) .label {
    display: none;
  }

  @media (width < 768px) {
    .rail {
      display: none;
    }
  }
</style>
