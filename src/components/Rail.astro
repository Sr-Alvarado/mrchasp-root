---
import type {NavItem} from '../lib/navigation'
import NavMarker from './NavMarker.astro'

type Props = {items: NavItem[]; label: string}

const {items, label} = Astro.props
---

<nav class="rail" aria-label={label}>
  <ul>
    {
      items.map((item) => (
        <li class={item.variant} style={`--chars: ${item.label.length}`}>
          <a href={item.href} data-nav={item.id}>
            <NavMarker item={item} />
            <span class="label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '../scripts/activeSection'
</script>

<style>
  .rail {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 2;
    width: var(--rail);
    background: var(--ink);
    color: var(--bg);
  }

  ul {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  li {
    position: relative;
    flex: 0 0 var(--s6);
    min-height: var(--s6);
    overflow: hidden;
    border-bottom: var(--stroke) solid color-mix(in srgb, currentColor 15%, transparent);
    container-type: size;
  }

  .home {
    min-height: 56px;
  }

  a {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    width: 100cqw;
    height: 100cqh;
    padding: var(--s2) 0 0 var(--s2);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: var(--s2);
    transform-origin: top left;
    transition:
      rotate var(--slow) ease-out,
      top var(--slow) ease-out,
      font-size var(--fast) ease-out;
  }

  a:hover {
    text-decoration: underline;
  }

  .home a {
    flex-direction: column;
    align-items: center;
    padding: var(--s4) 0;
  }

  .home .label {
    display: none;
  }

  @container (height > 160px) {
    a,
    .home a {
      top: 100%;
      flex-direction: row;
      align-items: center;
      gap: var(--s4);
      width: 100cqh;
      height: 100cqw;
      padding: 0 var(--s6);
      font-size: clamp(
        var(--text-xs),
        (100cqh - 2 * var(--s6) - var(--s4)) / (var(--chars) * 0.62 + 1),
        var(--text-4xl)
      );
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.02em;
      rotate: -90deg;
    }

    .home .label {
      display: inline;
    }

    a > :global(*:first-child) {
      width: 1em;
      height: 1em;
    }
  }

  @media (width < 768px) {
    .rail {
      display: none;
    }
  }
</style>
