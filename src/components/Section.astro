---
import Button from './Button.astro'

type Props = {
  id: string
  title: string | undefined
  description?: string | undefined
  url?: string | null | undefined
}

const {id, title, description, url} = Astro.props
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="heading">
    <div class="titles">
      <h2 id={`${id}-title`}>{title}</h2>
      {description && <p>{description}</p>}
    </div>
    {
      url && (
        <Button variant="tertiary" href={url} icon="ph:arrow-up-right-light">
          {new URL(url).host}
        </Button>
      )
    }
  </div>
  <slot />
</section>

<style>
  .section {
    padding: var(--s12) var(--gutter);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s8);
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }

  h2 {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.1;
  }

  p {
    font-size: var(--text-base);
    color: var(--ink-muted);
  }
</style>
