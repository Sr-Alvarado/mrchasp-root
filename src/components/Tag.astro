---
type Props = {color?: string | undefined}

const {color} = Astro.props
---

<span class="tag" style={color && `color: ${color}`}><slot /></span>

<style>
  .tag {
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: var(--s4);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
