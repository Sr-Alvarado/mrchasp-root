---
import type {Palette} from '../../sanity.types'

type Props = {days: string[]; palettes: Record<'light' | 'dark', Palette>}

const {days, palettes} = Astro.props
---

<canvas
  class="activity"
  aria-hidden="true"
  data-activity
  data-days={JSON.stringify(days)}
  data-palettes={JSON.stringify(palettes)}
></canvas>

<style>
  .activity {
    position: fixed;
    top: 0;
    left: var(--rail);
    z-index: 0;
    width: calc(100% - var(--rail));
    height: 100%;
    pointer-events: none;
  }

  @media (width < 768px) {
    .activity {
      left: 0;
      width: 100%;
      height: calc(100% - var(--bar));
    }
  }
</style>

<script>
  import {currentTheme} from '../scripts/theme'

  type Colors = {ink: string; accent: string; activity: string[]}

  const cellSize = 10
  const step = cellSize + 4
  const dayMs = 86_400_000
  const glowMs = 1000

  const canvas = document.querySelector('[data-activity]') as HTMLCanvasElement
  const context = canvas.getContext('2d') as CanvasRenderingContext2D
  const palettes: Record<'light' | 'dark', Colors> = JSON.parse(canvas.dataset.palettes as string)
  const motion = matchMedia('(prefers-reduced-motion: no-preference)').matches

  const startOfDay = (date: Date) =>
    new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime()
  const today = startOfDay(new Date())
  const dayIndex = (iso: string) => Math.round((today - startOfDay(new Date(iso))) / dayMs)

  const counts = new Map<number, number>()
  for (const iso of JSON.parse(canvas.dataset.days as string) as string[]) {
    const index = dayIndex(iso)
    counts.set(index, (counts.get(index) ?? 0) + 1)
  }
  const maxCount = Math.max(1, ...counts.values())
  const tints = new Map([...counts.keys()].map((index) => [index, {color: 0, changeAt: 0}]))

  const glows = new Map<number, number>()
  let columns = 0
  let phases = new Float32Array()
  let pointerCell = -1
  let hoveredDay: number | undefined

  const fillCell = (index: number) =>
    context.fillRect((index % columns) * step, Math.floor(index / columns) * step, cellSize, cellSize)

  const paint = (index: number, color: string, alpha: number) => {
    context.fillStyle = color
    context.globalAlpha = alpha
    fillCell(index)
  }

  const render = (now: number) => {
    const colors = palettes[currentTheme()]
    context.clearRect(0, 0, canvas.width, canvas.height)
    context.fillStyle = colors.ink
    phases.forEach((phase, index) => {
      context.globalAlpha = 0.0525 + 0.0275 * Math.sin(motion ? now / 3000 + phase : phase)
      fillCell(index)
    })
    const fadeIn = motion ? Math.min(1, now / 2000) : 1
    for (const [index, tint] of tints) {
      if (motion && now > tint.changeAt) {
        tint.color = Math.floor(Math.random() * colors.activity.length)
        tint.changeAt = now + 3000 + Math.random() * 4000
      }
      const color = colors.activity[tint.color % colors.activity.length]
      if (color) paint(index, color, (0.2 * fadeIn * (counts.get(index) ?? 0)) / maxCount)
    }
    for (const [index, litAt] of glows) {
      const glow = 1 - (now - litAt) / glowMs
      if (glow > 0) paint(index, colors.accent, 0.35 * glow)
      else glows.delete(index)
    }
    if (hoveredDay !== undefined) paint(hoveredDay, colors.accent, 0.8)
  }

  const frame = (now: number) => {
    render(now)
    if (motion) requestAnimationFrame(frame)
  }

  const redraw = () => {
    if (!motion) requestAnimationFrame(render)
  }

  new ResizeObserver(() => {
    const ratio = devicePixelRatio
    canvas.width = canvas.clientWidth * ratio
    canvas.height = canvas.clientHeight * ratio
    context.setTransform(ratio, 0, 0, ratio, 0, 0)
    columns = Math.ceil(canvas.clientWidth / step)
    phases = Float32Array.from(
      {length: columns * Math.ceil(canvas.clientHeight / step)},
      () => Math.random() * Math.PI * 2,
    )
    redraw()
  }).observe(canvas)

  for (const type of ['pointerover', 'focusin']) {
    document.addEventListener(type, (event) => {
      const day = (event.target as Element).closest<HTMLElement>('[data-day]')?.dataset.day
      hoveredDay = day ? dayIndex(day) : undefined
      redraw()
    })
  }

  if (motion) {
    addEventListener('pointermove', (event) => {
      const rect = canvas.getBoundingClientRect()
      const column = Math.floor((event.clientX - rect.left) / step)
      const index = Math.floor((event.clientY - rect.top) / step) * columns + column
      if (index === pointerCell || column < 0 || column >= columns || index >= phases.length) return
      pointerCell = index
      glows.set(index, event.timeStamp)
      const neighbor =
        index + (Math.random() < 0.5 ? 1 : columns) * (Math.random() < 0.5 ? 1 : -1)
      if (Math.random() < 0.2 && neighbor >= 0 && neighbor < phases.length) {
        glows.set(neighbor, event.timeStamp)
      }
    })
    requestAnimationFrame(frame)
  } else {
    new MutationObserver(redraw).observe(document.documentElement, {
      attributeFilter: ['data-theme'],
    })
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redraw)
  }
</script>
