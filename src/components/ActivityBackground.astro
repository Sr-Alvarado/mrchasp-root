---
import type {Palette} from '../../sanity.types'

type Props = {days: string[]; palettes: Record<'light' | 'dark', Palette>}

const {days, palettes} = Astro.props
---

<canvas
  class="activity"
  aria-hidden="true"
  data-activity
  data-days={JSON.stringify(days)}
  data-palettes={JSON.stringify(palettes)}
></canvas>

<style>
  .activity {
    position: fixed;
    top: 0;
    left: var(--rail);
    z-index: 0;
    width: calc(100% - var(--rail));
    height: 100%;
    pointer-events: none;
  }

  @media (width < 768px) {
    .activity {
      left: 0;
      width: 100%;
      height: calc(100% - var(--bar));
    }
  }
</style>

<script>
  import {currentTheme} from '../scripts/theme'

  type Colors = {ink: string; accent: string}

  const hues = {
    light: ['#0095a8', '#fa8900', '#00b368', '#ff5792', '#5842ff'],
    dark: ['#16a3b6', '#e4b781', '#49e9a6', '#df769b', '#7060eb'],
  }
  const cellSize = 7
  const step = 15
  const litShare = 0.5
  const hueShare = 9 / 10
  const hueAlpha = 0.5
  const intensity = 0.35
  const levels = [0.4, 0.6, 0.8, 1]
  const fadeMs = 600
  const glowMs = 1000
  const dayMs = 86_400_000

  const canvas = document.querySelector('[data-activity]') as HTMLCanvasElement
  const context = canvas.getContext('2d') as CanvasRenderingContext2D
  const palettes: Record<'light' | 'dark', Colors> = JSON.parse(canvas.dataset.palettes as string)
  const motion = matchMedia('(prefers-reduced-motion: no-preference)').matches

  const startOfDay = (date: Date) =>
    new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime()
  const today = startOfDay(new Date())
  const dayIndex = (iso: string) => Math.round((today - startOfDay(new Date(iso))) / dayMs)

  const counts = new Map<number, number>()
  for (const iso of JSON.parse(canvas.dataset.days as string) as string[]) {
    const index = dayIndex(iso)
    counts.set(index, (counts.get(index) ?? 0) + 1)
  }
  const maxCount = Math.max(1, ...counts.values())

  const glows = new Map<number, number>()
  let columns = 0
  let phases = new Float32Array()
  let colorIndex = new Int8Array()
  let alphas = new Float32Array()
  let changedAt = new Float32Array()
  let changeAt = new Float32Array()
  let pointerCell = -1
  let hoveredDay: number | undefined

  const paint = (index: number, color: string, alpha: number) => {
    context.fillStyle = color
    context.globalAlpha = alpha
    context.beginPath()
    context.arc(
      (index % columns) * step + step / 2,
      Math.floor(index / columns) * step + step / 2,
      cellSize / 2,
      0,
      Math.PI * 2,
    )
    context.fill()
  }

  const reroll = (index: number, now: number) => {
    const lit = Math.random() < litShare
    colorIndex[index] = !lit ? -2 : Math.random() < hueShare ? Math.floor(Math.random() * hues.light.length) : -1
    alphas[index] = intensity * (levels[Math.floor(Math.random() * levels.length)] as number)
    changedAt[index] = now
    changeAt[index] = now + 4000 + Math.random() * 12000
  }

  const render = (now: number) => {
    const theme = currentTheme()
    const colors = palettes[theme]
    context.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight)
    phases.forEach((phase, index) => {
      paint(index, colors.ink, 0.0525 + 0.0275 * Math.sin(motion ? now / 3000 + phase : phase))
      if (motion && now > (changeAt[index] as number)) reroll(index, now)
      const count = counts.get(index)
      const color = colorIndex[index] as number
      if (count) paint(index, colors.accent, intensity * (0.4 + (0.6 * count) / maxCount))
      else if (color > -2) {
        const fade = motion ? Math.min(1, (now - (changedAt[index] as number)) / fadeMs) : 1
        paint(index, color < 0 ? colors.accent : (hues[theme][color] as string), fade * (alphas[index] as number) * (color < 0 ? 1 : hueAlpha))
      }
    })
    for (const [index, litAt] of glows) {
      const glow = 1 - (now - litAt) / glowMs
      if (glow > 0) paint(index, colors.accent, intensity * glow)
      else glows.delete(index)
    }
    if (hoveredDay !== undefined) paint(hoveredDay, colors.accent, 1)
  }

  const frame = (now: number) => {
    render(now)
    if (motion) requestAnimationFrame(frame)
  }

  const redraw = () => {
    if (!motion) requestAnimationFrame(render)
  }

  new ResizeObserver(() => {
    const ratio = devicePixelRatio
    canvas.width = Math.round(canvas.clientWidth * ratio)
    canvas.height = Math.round(canvas.clientHeight * ratio)
    context.setTransform(ratio, 0, 0, ratio, 0, 0)
    columns = Math.ceil(canvas.clientWidth / step)
    const length = columns * Math.ceil(canvas.clientHeight / step)
    phases = Float32Array.from({length}, () => Math.random() * Math.PI * 2)
    colorIndex = new Int8Array(length)
    alphas = new Float32Array(length)
    changedAt = new Float32Array(length)
    changeAt = new Float32Array(length)
    const now = performance.now()
    for (let index = 0; index < length; index++) reroll(index, now - fadeMs)
    glows.clear()
    redraw()
  }).observe(canvas)

  for (const type of ['pointerover', 'focusin']) {
    document.addEventListener(type, (event) => {
      const day = (event.target as Element).closest<HTMLElement>('[data-day]')?.dataset.day
      hoveredDay = day ? dayIndex(day) : undefined
      redraw()
    })
  }

  if (motion) {
    addEventListener('pointermove', (event) => {
      const rect = canvas.getBoundingClientRect()
      const column = Math.floor((event.clientX - rect.left) / step)
      const index = Math.floor((event.clientY - rect.top) / step) * columns + column
      if (index === pointerCell || column < 0 || column >= columns || index >= phases.length) return
      pointerCell = index
      glows.set(index, event.timeStamp)
      const neighbor =
        index + (Math.random() < 0.5 ? 1 : columns) * (Math.random() < 0.5 ? 1 : -1)
      if (Math.random() < 0.2 && neighbor >= 0 && neighbor < phases.length) {
        glows.set(neighbor, event.timeStamp)
      }
    })
    requestAnimationFrame(frame)
  } else {
    new MutationObserver(redraw).observe(document.documentElement, {
      attributeFilter: ['data-theme'],
    })
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redraw)
  }
</script>
