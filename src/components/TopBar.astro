---
import {channelIcon} from '../lib/channelIcon'
import type {ChannelEntry} from '../lib/content'
import {type Locale, ui} from '../lib/i18n'
import Button from './Button.astro'
import LangToggle from './LangToggle.astro'
import ThemeToggle from './ThemeToggle.astro'

type Props = {channels: ChannelEntry[]; locale: Locale}

const {channels, locale} = Astro.props
const t = ui[locale]
---

<header class="topbar" data-header>
  <ul class="channels" aria-label={t.channels}>
    {
      channels.map((channel) => (
        <li>
          <Button
            variant="tertiary"
            href={channel.url}
            icon={channelIcon(channel.platform)}
            aria-label={channel.platform}
            title={channel.platform}
          />
        </li>
      ))
    }
  </ul>
  <span class="separator" aria-hidden="true"></span>
  <LangToggle current={locale} label={t.language} />
  <ThemeToggle label={t.theme} />
</header>

<script>
  import '../scripts/scrolledHeader'
</script>

<style>
  .topbar {
    position: fixed;
    top: calc(var(--s6) - var(--s2));
    right: calc(var(--gutter) - var(--s2));
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: var(--s2);
    transition:
      background-color var(--fast) ease-out,
      backdrop-filter var(--fast) ease-out;
  }

  .topbar[data-scrolled] {
    background-color: color-mix(in srgb, var(--bg) 65%, transparent);
    backdrop-filter: blur(12px);
  }

  .channels {
    display: flex;
    gap: var(--s2);
  }

  .separator {
    width: var(--stroke);
    height: var(--s4);
    background: var(--line);
  }

  @media (width < 768px) {
    .topbar {
      top: calc(var(--s4) - var(--s2));
      left: calc(var(--gutter) - var(--s2));
    }

    .channels {
      margin-right: auto;
    }

    .separator {
      display: none;
    }
  }
</style>
