---
import {Font} from 'astro:assets'
import {getRelativeLocaleUrl} from 'astro:i18n'
import SpeedInsights from '@vercel/speed-insights/astro'
import type {Palette} from '../../sanity.types'
import {content} from '../lib/content'
import {defaultLocale, type Locale, locales, localize} from '../lib/i18n'
import {icons} from '../lib/icons'
import {ogImage} from '../lib/ogImage'
import {themeKey} from '../scripts/theme'
import '../styles/global.css'
import StructuredData from './StructuredData.astro'

type Props = {
  locale: Locale
  title: string | undefined
  description: string | undefined
}

const {locale, title, description} = Astro.props
const {light, dark} = content.palettes
const ogImageUrl = new URL('/og.jpg', Astro.site)
const xHandle = content.channels.find((channel) => channel.platform?.toLowerCase() === 'x')?.handle
const ogLocale = (value: Locale) => {
  const {language, region} = new Intl.Locale(value).maximize()
  return `${language}_${region}`
}
const roles = Object.keys(light).filter((role) => role !== '_type' && role !== 'activity')
const themeCss = `:root{${roles
  .map((role) => {
    const key = role as keyof Palette
    return `--${role.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}:light-dark(${light[key]},${dark[key]})`
  })
  .join(';')}}`
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url} />
    {
      locales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate}
          href={new URL(getRelativeLocaleUrl(alternate), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl(defaultLocale), Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      icons
        .filter((icon) => icon.use !== 'manifest')
        .map(({name, size, use}) => (
          <link rel={use} href={`/${name}.png`} sizes={`${size}x${size}`} type="image/png" />
        ))
    }
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={light.bg} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={dark.bg} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.profile.alias} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {
      locales
        .filter((alternate) => alternate !== locale)
        .map((alternate) => <meta property="og:locale:alternate" content={ogLocale(alternate)} />)
    }
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={localize(content.profile.og.alt, locale)} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {xHandle && <meta name="twitter:site" content={xHandle} />}
    {
      content.root.umamiWebsiteId && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={content.root.umamiWebsiteId}
        />
      )
    }
    <StructuredData locale={locale} title={title} description={description} />
    <Font cssVariable="--font-lexend" preload />
    <style is:inline set:html={themeCss}></style>
    <script is:inline define:vars={{themeKey}}>
      const theme = localStorage.getItem(themeKey)
      if (theme) document.documentElement.dataset.theme = theme
    </script>
  </head>
  <body>
    <slot />
    <SpeedInsights />
  </body>
</html>
