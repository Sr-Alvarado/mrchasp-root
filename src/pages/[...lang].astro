---
import ActivityBackground from '../components/ActivityBackground.astro'
import BottomBar from '../components/BottomBar.astro'
import CardGrid from '../components/CardGrid.astro'
import Contact from '../components/Contact.astro'
import FeedCard from '../components/FeedCard.astro'
import Hero from '../components/Hero.astro'
import Layout from '../components/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Rail from '../components/Rail.astro'
import Section from '../components/Section.astro'
import Ticker from '../components/Ticker.astro'
import TopBar from '../components/TopBar.astro'
import {content} from '../lib/content'
import {defaultLocale, type Locale, locales, localize} from '../lib/i18n'
import {ui} from '../lib/ui'
import type {NavItem} from '../lib/navigation'
import {onBackground, onInk} from '../lib/siteColor'

export const getStaticPaths = () =>
  locales.map((locale) => ({
    params: {lang: locale === defaultLocale ? undefined : locale},
    props: {locale},
  }))

type Props = {locale: Locale}

const cardCount = 4
const tickerPerSource = 3

const {locale} = Astro.props
const t = ui[locale]
const {profile, palettes, root, sites, channels, projects, feed} = content
const cvUrl = sites.find((site) => site.key === 'cv')?.url
const sectionSites = sites.filter((site) => site.key !== 'cv')

const tickerFeed = Object.values(Object.groupBy(feed, (item) => item.source ?? ''))
  .flatMap((items) => items?.slice(0, tickerPerSource) ?? [])
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
  .map((item) => {
    const site = sites.find((candidate) => candidate.key === item.source)
    const channel = channels.find((candidate) => candidate.platform?.toLowerCase() === item.source)
    return {
      source: site?.name ?? channel?.platform ?? item.source,
      sourceUrl: site?.url ?? channel?.url,
      color: site && onBackground(site),
      title: item.title ?? item.text,
      url: item.url,
      day: item.publishedAt,
    }
  })

const siteSections = sectionSites
  .map((site) => ({
    site,
    projects: site.key === 'lab' ? projects.slice(0, cardCount) : [],
    items: site.key === 'lab' ? [] : feed.filter((item) => item.source === site.key).slice(0, cardCount),
  }))
  .filter((section) => section.projects.length + section.items.length > 0)

const navItems: NavItem[] = [
  {id: 'inicio', label: t.home, href: '#inicio', variant: 'home'},
  ...(tickerFeed.length > 0
    ? [{id: 'ando', label: t.now, href: '#ando', variant: 'now' as const, color: onInk(root)}]
    : []),
  ...sites
    .filter((site) => site.key === 'cv' || siteSections.some((section) => section.site === site))
    .map((site) => ({
      id: site.key,
      label: site.name ?? site.key,
      href: site.key === 'cv' ? (site.url ?? '') : `#${site.key}`,
      variant: 'site' as const,
      color: onInk(site),
    })),
  {id: 'contacto', label: t.contact, href: '#contacto', variant: 'contact'},
]
---

<Layout
  locale={locale}
  title={profile.alias}
  description={localize(profile.bio, locale)}
  image={profile.og}
>
  <Rail items={navItems} label={t.sections} />
  <BottomBar items={navItems} label={t.sections} />
  <TopBar channels={channels.filter((channel) => channel.showInHero)} locale={locale} />
  <main>
    <Hero profile={profile} cvUrl={cvUrl} locale={locale} />
    <Ticker
      id="ando"
      label={t.nowTitle}
      items={tickerFeed}
    />
    {
      siteSections.map(({site, projects, items}) => (
        <Section
          id={site.key}
          title={site.name}
          description={localize(site.description, locale)}
          url={site.url}
        >
          <CardGrid>
            {projects.map((project) => (
              <ProjectCard project={project} locale={locale} />
            ))}
            {items.map((item) => (
              <FeedCard item={item} color={onBackground(site)} locale={locale} />
            ))}
          </CardGrid>
        </Section>
      ))
    }
    <Section id="contacto" title={t.contact}>
      <Contact channels={channels} cvUrl={cvUrl} locale={locale} />
    </Section>
  </main>
  <ActivityBackground days={feed.map((item) => item.publishedAt)} palettes={palettes} />
</Layout>
